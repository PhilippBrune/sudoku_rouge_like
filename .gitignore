# Python / AI tooling (local only — not part of the game)
# ============================================================
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
.env
.env.*

# Local tooling directories
ai/
foocus_api/
tools/
requirements/
retired/
_empty/

# One-off utility scripts and scan output
_scan_*.py
_scan_result*.txt
_coverage_result.txt
_gaps_detail.txt
agent.ps1

# ============================================================
# IDE / Editor settings
# ============================================================
.vscode/

# ============================================================
# Claude Code session data (personal, not part of project)
# Project skills under .claude/skills/ are shared and tracked.
# ============================================================
.claude/*
!.claude/skills/

# ============================================================
# Nested legacy Unity project cache folders
# ============================================================
Assets/Scripts/My project/
Assets/Scripts/My project_clean/
Assets/Scripts/My project/[Ll]ibrary/
Assets/Scripts/My project/[Tt]emp/
Assets/Scripts/My project/[Oo]bj/
Assets/Scripts/My project/[Ll]ogs/
Assets/Scripts/My project/UserSettings/

# ============================================================
# Local git hooks helpers
# ============================================================
.githooks/*.local

# ============================================================
# Local git hook helpers only; CI workflow definitions are tracked
# ============================================================
.githooks/
!.github/
!.github/workflows/
!.github/workflows/*.yml
!.github/workflows/*.yaml

# Build output
bin/
# macOS player build folder (Unity names it <name>.app)
build.app/

# Unity batchmode test output
TestResults/

# Repo-managed workflow scripts
!tools/
!tools/run-unity-tests.ps1
!tools/*.ps1
!tools/*.py

# CI-required solution and project files (must stay tracked despite *.slnx / *.csproj rules above)
!sudoku_rouge_like.slnx
!Game.csproj
!GameTests.EditMode.csproj
!GameTests.PlayMode.csproj

# Generated by tools/localization/export_missing.py
tools/localization/out/

# Mureka takes (tools/audio/mureka_generate.py); the chosen takes are imported into Assets/Resources/audio
steam_assets/audio_8bit/mureka/
